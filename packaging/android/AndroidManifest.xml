<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.u10yukine.meridian.dev"
    android:versionCode="1"
    android:versionName="0.1.0-dev">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:label="Meridian Dev"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:hasCode="true">
        <!-- NativeActivity plus what the NDK cannot do (java/, MeridianActivity). -->
        <activity
            android:name="io.github.u10yukine.meridian.MeridianActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|uiMode|smallestScreenSize|density"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <meta-data android:name="android.app.lib_name" android:value="meridian" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Between the launcher's process and the game's: waits for one to end, starts the
             other (java/, RestartActivity). -->
        <activity
            android:name="io.github.u10yukine.meridian.RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
